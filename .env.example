# Database
DATABASE_URL=postgresql://username:password@localhost:5432/database_name?sslmode=require

# Airtable Integration
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Instagram Integration (via Facebook)
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# Imgur Integration
IMGUR_CLIENT_ID=your_imgur_client_id_here
IMGUR_CLIENT_SECRET=your_imgur_client_secret_here

# Session Secret — REQUIRED in production; the server refuses to boot without it.
# Generate with: openssl rand -hex 32
SESSION_SECRET=generate_a_secure_random_string_here

# Shared secret for inbound webhooks, sent as the x-webhook-secret header.
# /api/webhooks/article-published triggers a full Airtable sync, so leaving this
# unset in production leaves that open to anyone.
WEBHOOK_SECRET=generate_a_secure_random_string_here

# Where the live site's cache-refresh webhook lives. Required for the site to
# pick up publishes; without it refreshes are skipped and logged.
PRODUCTION_WEBHOOK_URL=

# Database TLS. Set when your provider terminates TLS with a private CA;
# certificate verification is always on in production.
DATABASE_CA_CERT=

# --- Upload limits (all optional; defaults shown) ---
# UPLOAD_MAX_IMAGE_BYTES=10485760
# UPLOAD_MAX_ZIP_BYTES=52428800
# UPLOAD_MAX_ZIP_EXPANDED_BYTES=209715200   # zip-bomb guard
# UPLOAD_MAX_ZIP_ENTRIES=500
# UPLOAD_MAX_ZIP_IMAGES=60
# UPLOAD_TOKEN_TTL_DAYS=14

# Frontend variables (prefixed with VITE_)
VITE_FACEBOOK_APP_ID=${FACEBOOK_APP_ID}

# Base URL for your application
BASE_URL=http://localhost:3000

# Instagram Webhook Verification Token (optional, for webhooks)
INSTAGRAM_VERIFY_TOKEN=your_webhook_verify_token_here
