# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string. The server throws at startup without it.
DATABASE_URL=postgresql://username:password@localhost:5432/database_name?sslmode=require

# Signs session cookies. REQUIRED in production — the server refuses to boot
# without it. In development it falls back to a known insecure default and warns.
# Generate with: openssl rand -hex 32
SESSION_SECRET=generate_a_secure_random_string_here

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# ImgBB hosts every uploaded image before its URL is written to Airtable.
# This is the ONLY place the key is read from — it is not configurable in the
# CMS, and `integration_settings` will refuse to store it. Read once at boot,
# so rotating it needs a restart. Unset, the image upload routes fail and the
# server otherwise runs normally.
IMGBB_API_KEY=your_imgbb_api_key_here

# Shared secret for the inbound webhook, sent as the x-webhook-secret header.
# /api/webhooks/article-published ignores its body and triggers a full Airtable
# sync of every article, so leaving this unset in production leaves an
# expensive endpoint open to anyone.
WEBHOOK_SECRET=generate_a_secure_random_string_here

# Where to tell the live site to drop its cached copy of an article.
# Not strictly required: with this unset, RAILWAY_PUBLIC_DOMAIN is used to build
# a URL back to this server's own /api/webhooks/article-published. With neither
# set, refreshes are skipped and logged.
# Note the shared secret above is only attached to that self-target fallback —
# an external URL set here never receives it.
PRODUCTION_WEBHOOK_URL=

# Database TLS. Set this when your provider terminates TLS with a private CA.
# WITHOUT it, the production pool connects over TLS but does NOT verify the
# peer certificate. That is acceptable on a provider's private network; set
# this when the database is reached over the public internet.
DATABASE_CA_CERT=

# Mount the Airtable diagnostic routes, which write to real Airtable records.
# Read the condition carefully — it is `=== 'true' || NODE_ENV !== 'production'`:
#   - outside production they are ALWAYS on, and setting this to false does not
#     turn them off
#   - in production they are off unless this is the literal string 'true'
# So running a development server against a production Airtable base will write
# to it.
# ENABLE_DIAGNOSTIC_ROUTES=false

# Port to bind. When set, it is authoritative and a bind failure is fatal.
# When unset, the server tries 3000, 3001, 3002, 3003, 3004, 5000, 5001, 5002
# in order. (In development an optional HTTPS listener also wants 3001, so
# prefer setting this explicitly if 3000 is ever taken.)
PORT=3000

# Base URL used to build contributor upload links. Falls back to
# https://$RAILWAY_PUBLIC_DOMAIN, then to http://localhost:$PORT — so an unset
# value in production means every link you send out points at localhost.
BASE_URL=http://localhost:3000

# How often the auto-publish scheduler checks for due articles, in ms.
# SCHEDULER_INTERVAL_MS=60000

# --- Upload limits (all optional; defaults shown) ---
# UPLOAD_MAX_IMAGE_BYTES=10485760
# UPLOAD_MAX_ZIP_BYTES=52428800
# UPLOAD_MAX_ZIP_EXPANDED_BYTES=209715200   # zip-bomb guard
# UPLOAD_MAX_ZIP_ENTRIES=500
# UPLOAD_MAX_ZIP_IMAGES=60
# UPLOAD_TOKEN_TTL_DAYS=14

# ---------------------------------------------------------------------------
# Not read by the server
# ---------------------------------------------------------------------------

# Airtable credentials are NOT environment variables. They live in the
# integration_settings table and are entered through the admin UI at
# /integrations/airtable. The app boots fine with none configured; it simply
# cannot sync until they are.
#
# The two variables below are read only by scripts/ (createAdmin.js,
# test-setup.js, cleanup-imgbb-settings.mjs) and by the one admin endpoint
# POST /api/airtable/update-api-key, which copies AIRTABLE_API_KEY into the
# database. No other server code reads them.
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
